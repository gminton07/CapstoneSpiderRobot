<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spider">

  <xacro:macro name="spider_ros2_control" params="use_mock_hardware">

    <ros2_control name="SpiderCapstoneHardwareInterface" type="system">
      
      <!-- Change which hardware plugin to use -->
      <xacro:unless value="${use_mock_hardware}">
        <hardware>
          <plugin>spider_capstone_hardware/SpiderHardwareInterface</plugin>
          <param name="calculate_dynamics">false</param>
        </hardware>
      </xacro:unless>
      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>
      </xacro:if>

      <!-- Leg macro [Only use effort with mock system] -->
      <xacro:macro name="ros2_control" params="prefix">
        <joint name="${prefix}_hip">
          <command_interface name="position"/>
          <xacro:if value="${use_mock_hardware}">
            <command_interface name="effort"/>
          </xacro:if>
          <state_interface name="position"/>
        </joint>
        <joint name="${prefix}_knee">
          <command_interface name="position"/>
          <xacro:if value="${use_mock_hardware}">
            <command_interface name="effort"/>
          </xacro:if>
          <state_interface name="position"/>
        </joint>
        <joint name="${prefix}_ankle">
          <command_interface name="position"/>
          <xacro:if value="${use_mock_hardware}">
            <command_interface name="effort"/>
          </xacro:if>
          <state_interface name="position"/>
        </joint>
      </xacro:macro>

      <xacro:ros2_control prefix="fr"/>
      <xacro:ros2_control prefix="fl"/>
      <xacro:ros2_control prefix="bl"/>
      <xacro:ros2_control prefix="br"/>

    </ros2_control>

  </xacro:macro>

</robot>
